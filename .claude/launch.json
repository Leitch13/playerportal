{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js Dev Server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Landing Page",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "marketing/landing-page",
        "-l",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "Academy Leads",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4002",
        "--directory",
        "marketing/academy-leads"
      ],
      "port": 4002
    }
  ]
}